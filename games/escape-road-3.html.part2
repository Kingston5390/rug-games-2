		scripty.src = f;
		document.body.appendChild(scripty);
	  })
      
       

        var buildUrl = "Build";
        var loaderUrl = buildUrl + "/escape-road-3-v26041006.loader.js";
        var config = {
          dataUrl: buildUrl + "/escape-road-3-v26041006.data",
          frameworkUrl: buildUrl + "/escape-road-3-v26041006.framework.js",
          codeUrl: buildUrl + "/escape-road-3-v26041006.wasm",
          streamingAssetsUrl: "StreamingAssets",
          companyName: "s",
          productName: "sss",
          productVersion: "26041006",
        };
        config.gameId = "escape-road-3";
        config.eventLog = true;
        let currentDate = new Date();
        let endLogDate = new Date("2026-04-28T09:43:42.671Z");
        if (currentDate > endLogDate) {
          config.eventLog = false;
        }
        function isDiffHost() {
          return false;
        }
        window["GMSOFT_SDKTYPE"] = "gm";
        localStorage.setItem(
          "gmsdksigndomain",
          "",
        );

        var progressElement = document.getElementById("progress_fill");
        var container = document.getElementById("unity-container");
        var canvas = document.getElementById("unity-canvas");
        var loadingBar = document.querySelector("#loadingBlock");
        var progressBarFull = document.querySelector("#progress_fill");
        var progress_text = document.querySelector(".gameloader-progress-info");
        var loadingtext = document.querySelector("#loading-text");
        let text_percent = "";
        var script = document.createElement("script");
        script.src = loaderUrl;
        script.onload = () => {
          createUnityInstance(canvas, config, (progress) => {
            progressElement.style.width = 100 * progress + "%";
            text_percent =
              "Downloading file: " + Math.round(progress * 100) + "%";
            progress_text.innerText = text_percent;
            if (progress >= 99) {
              progress_text.innerText = "Game Loading ...";
            }
          })
            .then((unityInstance) => {
              window.unityInstance = unityInstance;
              setTimeout(function () {
                loadingBar.style.display = "none";
                loadingtext.remove();
                window.focus();
              }, 2000);
              container.style.display = "block";
            })
            .catch((message) => {
              alert(message);
            });
        };
        document.body.appendChild(script);
     
	 
	 
