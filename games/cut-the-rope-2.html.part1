        <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover" name=viewport>
        
        <style>
            * {
                padding: 0;
                margin: 0
            }

            html {
                height: -webkit-fill-available
            }

            body {
                height: 100%;
                height: -webkit-fill-available;
                width: 100%;
                text-align: center;
                background: #000;
                overflow: hidden;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0
            }

            .game {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                margin: 0;
                border: 0;
                overflow: hidden;
                display: block;
                image-rendering: auto;
                -ms-interpolation-mode: bicubic
            }

            #x_unity-loading-bar {
                position: relative;
                width: 40%;
                height: 5px;
                background-color: #555;
                border: 1px solid #000;
                border-radius: 5px
            }

            #x_unity-loading-bar-inner {
                position: absolute;
                left: 0;
                top: 0;
                width: 1%;
                height: 100%;
                background-color: #fff;
                border-radius: 5px;
                transition: .4s linear
            }
        </style>
        <style id=loading-percent-style>
            .loading-percent {
                font-feature-settings: "tnum" 1,"lnum" 1;
                font-variant-numeric: tabular-nums;
                margin-top: 10px;
