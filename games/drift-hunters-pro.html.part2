";

            var config = {
                dataUrl: dataUrl,
                frameworkUrl: "data:application/vnd.unity;base64,",
                codeUrl: "data:application/vnd.unity;base64,",
                streamingAssetsUrl: "StreamingAssets",
                companyName: "FreezeNova",
                productName: "Crazy Drifter",
                productVersion: "0.1",
            };
            
            var scaleToFit,gameInstance;try{scaleToFit=!!JSON.parse("true")}catch(e){scaleToFit=!0}function progressHandler(e){var t=100*e+"%";canvas.style.background="linear-gradient(to right, white, white "+t+", transparent "+t+", transparent) no-repeat center",canvas.style.backgroundSize="100% 1rem"}function onResize(){var e,t,n=canvas.parentElement;if(scaleToFit){e=window.innerWidth,t=window.innerHeight;var a=.5625;e*a>window.innerHeight&&(e=Math.min(e,Math.ceil(t/a))),t=Math.floor(e*a)}else e=960,t=540;n.style.width=canvas.style.width=e+"px",n.style.height=canvas.style.height=t+"px",n.style.top=Math.floor((window.innerHeight-t)/2)+"px",n.style.left=Math.floor((window.innerWidth-e)/2)+"px"}function startGame(){console.log("Starting Unity with data from:",config.dataUrl),createUnityInstance(canvas,config,progressHandler).then(function(e){canvas=e.Module.canvas,onResize(),gameInstance=e}).catch(function(e){console.error("Unity failed to start:",e),canvas.style.background="#000",canvas.style.display="flex",canvas.style.alignItems="center",canvas.style.justifyContent="center",canvas.style.color="white",canvas.style.fontFamily="monospace",canvas.style.fontSize="14px",canvas.style.textAlign="center";const t=document.createElement("div");t.style.position="absolute",t.style.top="50%",t.style.left="50%",t.style.transform="translate(-50%, -50%)",t.style.color="#ff6666",t.style.backgroundColor="rgba(0,0,0,0.8)",t.style.padding="20px",t.style.borderRadius="10px",t.style.zIndex="1000",t.innerHTML="Game laadfout:<br>Controleer of het data-bestand correct geladen kan worden.",document.body.appendChild(t)})}startGame(),window.addEventListener("resize",onResize),onResize();
        </script>
    </div>
</body>

