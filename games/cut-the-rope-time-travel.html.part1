gAlBGO>]+gJ@jymXYBC"VuAANB@QAAAAAAAAAAumT3I<XtH;8PQnU%Z27gkCF2l?tAQABAAABtAAAAMc<7CAwW%|F8alpANcNtCAAAAAjX`mECAAAAAAAAAAAAuWAADAAAAAAAAA4}kZ4(BETft@_{L%(&NFDE:CgAAAAAIAAAC"2cVAQA/@T8N7:BJtHBUAgAlBGO>]+g?PI,kDRABt+LAA1B@QAAAAAAAAAAum3Li=XtI;,mRn$2!,y]jT2Te%48Wo/)AB$AEAAAAABAAAY47dFAFtl`Je1:]Aa4a"CAEAQAjX`mR;Xon2/GBAxdiAC"EAYAAAAAAAAAv(3t2aOg5*;Nc%`+<^?i_z8=r@BBn$K;EnD"5FAAAA:CAAAA[d"OuWe+TW*S^PzWDHb4AABAEAh/(2jRKh1EbYAA:&QAC"BAGAAAAAAAAA[9l4}5DIm!}+<^VoqrUft@_{L%1xhQ6ptoUft@1vBClBQAAAAAEAAABt2cVAQA/@T8N7:BJtHBUAgAlBGO>]+gB1<&VgSAAAUDAAFBoIAAAAAAAAAAXTCq~m6(y]jT2Th.<jZp$2/2Cu!YxS#0DC<mT8J>CAYLAAAA5FAAAA,7~dBt6ynsvl;fLtGO0WBACAIA$4qTP:"yL(*jAA~lfABtFAYAAAAAAAAAv(3tQOPg5*;Nc%`+<^5kpof<y]jT2Te%48Wo/)AB$AEAAAAABAAAY47dFAFtl`Je1:]Aa4a"CAEAQAjX`mo{shtC%UBAdZnAC"FAYAAAAAAAAAv(3tOhPg5*;Nc%`+<^5kpof<y]jT2Te%o.hk/)AB$AEAAAAABAAAY47dFAFtl`Je1:%DMAAAAAGBwIKi;ABtu{BEAAA';

var dataGroup;

function dataTable(original) {
if (original.includes("/768/")) original = original.replaceAll("/768/", "/1024/");

  if (original.startsWith("blob:") || original.startsWith("data:")) return original;
  
  
  
  let trimmed =  original.split("/").pop(); 
  let trimmed2 = original.split('?')[0];
  
  
  if (trimmed.includes("?")) trimmed = trimmed.split("?")[0]

 
  const match = trimmed2.match(/(audio|cursors|fonts|video|images|css|scripts)\/.*/);
  if (match) trimmed2 = match[0];

  return dataGroup[trimmed2] || dataGroup[trimmed] || original;
}
function rewriteCSS(cssText) {
  return cssText.replace(
    /url\(\s*(?:(["'])(.*?)\1|([^)]*?))\s*\)/gi,
    (match, quote, quotedURL, unquotedURL) => {
      const url = (quotedURL ?? unquotedURL).trim();
      const newURL = dataTable(url);

      return `url(${quote || ''}${newURL}${quote || ''})`;
    }
  );
	}

loadZip(zip, DATA_COMPRESSED).then(output => {

zip = null;
    
  dataGroup = output;
  
  
  
  cssString = rewriteCSS(cssString);
let style = document.createElement("style");
style.textContent = cssString;
document.head.appendChild(style);
  
  begin();

   





   
   
   
   
async function loadScripts() {
    const scripts = [
		'scripts/detectmobilebrowser.js',
        'scripts/sm2.js?238',
        'scripts/libraries.js?238',
        'scripts/ctr-time.js?238',
        '/js/main.js'
    ];

    for (const src of scripts) {
        await new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.onload = resolve;
            script.onerror = () => reject(new Error('Failed to load: ' + src));
            document.head.appendChild(script);
        });
    }
}

loadScripts().catch(console.error);

});
</script>
    <noscript>
        
    </noscript>
</head>
<body class="ctrCursor">
  <div id="lang">

    <style  type="text/css">
        .hideBeforeLoad, #loaderWindow, #popupWindow { display: none; }  
    </style>

    <div id="gameContainer">
        <div id="gameArea" class="hideBeforeLoad">
            <canvas id="c"></canvas>
            <div id="loadingPanel" class="panel"></div>
            <div id="startBackground" class="panel"></div>
            <div id="menuBackground" class="panel"></div>
            <div id="levelBackground" class="panel">
                <canvas id="levelCanvas"></canvas>
                <div id="levelTape" class="levelTape"></div>
                <div id="doorGradient"></div>
            </div>
            <div id="shadowPanel" class="panel">
                <canvas id="shadowCanvas" width="1024" height="576"></canvas>
            </div>
            <div id="menuPanel" class="panel seethrough">
                <div class="panelContent">
                    <div id="menuLogo" ></div>
                    <div id="menuBtnVbox" class="fBtnVBox">
                        <div id="playBtn" class="fBtn"><img src="" /></div>
                        <div id="optionsBtn" class="fBtn"><img src="" /></div>
                    </div>
                </div>
                <div id="miniOptionsMenu">
                    <div id="optionSd"></div>
                    <div id="optionHd"></div>
                    <div id="optionSound" class="ctrPointer"></div>
                    <div id="optionMsg"></div>
                </div>
            </div>

            <div id="boxPanel" class="panel seethrough">
                
                <canvas id="boxCanvas" width="1024" height="576"></canvas>
                <div id="boxEnterCodeButton" class="fBtn ctrPointer"></div>
                <div id="boxScore" class="hideFromMouse"><img src="" /></div>

                <div id="boxNavBack">
                    <div class="boxNavDisabled">
                    </div>
                </div>
                <div id="boxNavForward">
                    <div>
                    </div>
                </div>
                <div id="boxBack" class="bBtn">
                </div>
            </div>
            <div id="codePanel" class="panel seethrough">
                <input id="codeText" type="text" />
                <div id="codeOkButton" class="ctrPointer"></div>
                <div id="codeMessage"></div>
                <div id="codeBack" class="bBtn"></div>
            </div>
            <div id="levelPanel" class="panel">
                <div id="levelScore">
                    <img src="" /></div>
                <div id="levelBack" class="bBtn">
                </div>
                <div id="levelOptions"></div>
                <div id="levelResults">
                    <div id="resultStatus"><img src="" /></div>
                    <div class="starCase">
                        <div id="resultStar1" class=""></div>
                        <div id="resultStar2" class=""></div>
                        <div id="resultStar3" class=""></div>
                    </div>
                    <div id="resultTicker">
                        <img id="resultTickerLabel" />
                        <img id="resultTickerValue" />
                        <img id="resultTickerMessage" />
                    </div>
                    <div class="line"></div>
                    <div id="resultScore"></div>
                    <div class="btnCase">
                        <div id="replayBtn" class="sBtn"><img src="" /></div>
                        <div id="lrMenuBtn" class="sBtn"><img src="" /></div>
                        <div id="nextBtn" class="sBtn"><img src="" /></div>
                    </div>
                    <div id="resultImproved"></div>
                </div>
            </div>

            <div id="gameCompletePanel" class="panel">
                <div id="congrats"></div>
                <div id="finalScore"><img src="" /></div>
                <a href="../../" id="finalFunBtn" class="lBtn" target="_blank"><img src="" /><div id="funOmNom"></div></a>
                <div id="gameCompleteBack" class="bBtn"></div>
            </div>

            <div id="optionsPanel" class="panel">
                <div class="fBtnVBox">
                    <div id="optionsTitle"><img src="" /></div>
                    <div id="soundBtn" class="mini-button ctrCursor"><div id="options-speaker"></div><div class="options-x"></div></div>
                    <div id="musicBtn" class="mini-button ctrCursor"><div id="options-note"></div><div class="options-x"></div></div>
                    <div id="langBtn" class="fBtn"><img src="" /><div id="flag"></div></div>
                    <div id="resetBtn" class="fBtn"><img src="" /></div>
                    <div id="creditsBtn" class="fBtn"><img src="" /></div>
                    <div id="dragBtn"><img id="dragText" /><div class="options-check-disabled"></div></div>
                    <div id="cutBtn" class="ctrCursor"><img id="cutText" /><div class="options-check"></div></div>
                </div>
                <div id="optionsBack" class="bBtn"></div>
            </div>
            <div id="d" class="panel ctrPointer">
                <img id="dmsg" />
                <div id="dframe">
                    <div id="dpic"></div>
                </div>
                <div id="dshareBtn" class="fBtn"><img src="" /><div id="dfb"></div></div>
            </div>
            <div id="gameBtnTray">
                <div id="gameMsg" class="allSound"></div>
                <div id="gameSound" class="ctrPointer allSound"></div>
                <div id="gameRestartBtn" class="ctrPointer"></div>
                <div id="gameMenuBtn" class="ctrPointer"></div>
            </div>
            <div id="levelMenu">
                <div class="fBtnVBox">
                    <div id="continueBtn" class="fBtn"><img src="" /></div>
                    <div id="skipBtn" class="fBtn"><img src="" /></div>
                    <div id="selectBtn" class="fBtn"><img src="" /></div>
                    <div id="menuBtn" class="fBtn"><img src="" /></div>
                </div>
            </div>

            <div id="boxCutter">
            </div>
            <div id="tapeRoll">
            </div>
            <div id="video"></div>
            <div id="fadeToBlack" class="panel"></div>
        </div>
        <canvas id="e"></canvas>

        <div id="loaderWindow">
            <div id="loaderBubbles">
                <img id="loaderLogo" src="data:image/png;base64," />
                <div id="loaderCanvasHost">
                    <canvas id="loaderCanvas"></canvas>
                </div>
            </div>
        </div>

        <div id="lsWarning" style="display:none;">
            <p>
                Your browser settings won't allow us to save your game progress after you
                close this tab. This might happen if you've disabled cookies or site data
                for some domains.
            </p>
            <p>Don't worry, you can still play!</p>
            <p>
                Consider modifying your settings to allow <br/>
                our domain ( <span id="lsDomain"></span> ) <br/>
                to store site data so we can save your progress.
            </p>

            <a id="lsChromeInfoLink" target="_blank" href="http://support.google.com/chrome/bin/answer.py?hl=en&answer=95647">
                Details on how to manage your <br/> cookies and site data in Google Chrome
            </a>
            <div class="mBtn" id="lsOkButton"><span>OK</span></div>
        </div>
    </div>

    <div id="popupWindow">
        <div class="popupOuterFrame">
            <div class="popupInnerFrame" id="slowComputer">
                <div class="fBtn" id="slowComputerBtn"><img src="" /></div>
            </div>
            <div class="popupInnerFrame" id="resetGame">
                <div id="resetText"></div>
                <div class="mBtn" id="resetYesBtn"><img src="" /></div>
                <div class="mBtn" id="resetNoBtn"><img src="" /></div>
                <div id="resetHoldYes"></div>
            </div>
            <div class="popupInnerFrame" id="missingStars">
                <div id="missingLine1"></div>
                <div id="missingCount"><div id="missingStar"></div></div>
                <div id="missingLine2"></div>
                <div id="missingLine3"></div>
                <div class="mBtn" id="missingOkBtn"></div>
            </div>
        </div>
    </div>

    <div id="upgrade">
        <div id="upgrade-header"></div>
        <a id="upgrade-button" href="http://windows.microsoft.com/ie"></a>
    </div>
  </div>
</body>
</html>